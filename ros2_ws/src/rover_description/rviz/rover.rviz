Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Floor grid (10 cm)
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 40
      Color: 160; 160; 164
      Alpha: 0.4
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Rover
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Obstacles (sim)
      Enabled: true
      Topic:
        Value: /sim/obstacles
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Mission path
      Enabled: true
      Topic:
        Value: /rover/path
        Durability Policy: Transient Local
      Color: 25; 255; 120
      Line Style: Billboards
      Line Width: 0.01
      Pose Style: Axes
      Axes Length: 0.08
      Axes Radius: 0.008
      Value: true
    - Class: rviz_default_plugins/Range
      Name: Sonar
      Enabled: true
      Topic:
        Value: /rover/range
        Reliability Policy: Best Effort
      Color: 255; 200; 0
      Alpha: 0.35
      Buffer Length: 1
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Where the rover thinks it is
      Enabled: true
      Topic:
        Value: /odom
      Keep: 60
      Position Tolerance: 0.05
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 255; 85; 0
        Alpha: 0.8
        Shaft Length: 0.08
        Shaft Radius: 0.006
        Head Length: 0.03
        Head Radius: 0.012
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
  Global Options:
    Background Color: 38; 40; 46
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_link
      Distance: 1.6
      Pitch: 0.55
      Yaw: 2.4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Width: 1280
  Height: 800
