<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_sil</name>
  <version>0.1.0</version>
  <description>Runs the ESP32 brain and STM32 body logic from rover_core on the laptop, so the simulator exercises the same code as the robot.</description>
  <maintainer email="sarbfatehsuppal@users.noreply.github.com">Sarbfateh Suppal</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rover_core</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
